# ============================================================
# .gitignore — Mortgage Strategy Lab
# ============================================================
# Que versionar:   codigo fuente (.js, .md, .html, .css, .svg),
#                  package.json, package-lock.json (reproducibilidad)
# Que NO versionar: dependencias (node_modules), artefactos de
#                  build (dist/, iconos generados), logs, datos
#                  personales de prueba.
# ============================================================


# ────────────────────────────────
# Dependencias
# ────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Binarios de pkg-cache (descargas de Node para empaquetar)
.pkg-cache/


# ────────────────────────────────
# Artefactos de build
# ────────────────────────────────
dist/
# Los iconos PNG/ICO se regeneran desde assets/icon.svg.
# Si los versionas, evita que el repo crezca innecesariamente.
assets/favicon-*.png
assets/icon.ico
styles/favicon.svg

# Si quieres versionar los PNGs/ICO precompilados (ej. para Releases
# de GitHub), comenta las 3 lineas de arriba y añadelas a git a mano:
#   git add -f assets/icon.ico


# ────────────────────────────────
# Logs y temporales
# ────────────────────────────────
*.log
msl-out.log
msl-err.log
server-test*.log
exe-*.log
dev-*.log
stdout.log
stderr.log
out.log
err.log
smoke*.log
smoke-*.log
tmp/
*.tmp
*.bak
*.swp
*.swo


# ────────────────────────────────
# Sistema operativo
# ────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.Trashes
.Trash-*
Icon?
ehthumbs.db?


# ────────────────────────────────
# IDEs y editores
# ────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Si quieres compartir configs de tu editor en el repo, mueve los
# archivos especificos fuera del gitignore. Ejemplo:
#   !.vscode/settings.json
#   !.vscode/extensions.json


# ────────────────────────────────
# Tests / Coverage
# ────────────────────────────────
coverage/
.nyc_output/
*.lcov


# ────────────────────────────────
# Datos personales del usuario
# ────────────────────────────────
# La app guarda informacion personal (perfiles, propiedades, etc.)
# en IndexedDB. NO se exporta al repo por defecto.
#
# Si quieres compartir un JSON de ejemplo, asegurate de que NO
# contenga datos reales y ponlo en una carpeta especifica:
data/*.json
!data/.gitkeep

# Si quieres ignorar TODA la carpeta data/ (incluyendo .gitkeep):
# /data/


# ────────────────────────────────
# Archivos extraidos para debug (no deberian commitearse)
# ────────────────────────────────
extracted-icon.bin
extracted-from-windows.png
extracted-icon-from-windows.png


# ────────────────────────────────
# Variables de entorno (por si se anaden en el futuro)
# ────────────────────────────────
.env
.env.local
.env.*.local


# ────────────────────────────────
# OS-specific (Windows)
# ────────────────────────────────
# Carpetas de Visual Studio
.vs/
[Bb]in/
[Oo]bj/

# Carpetas de Windows
$WINDOWS.~BT
$WinREAgent

# PowerShell
*.ps1~


# ────────────────────────────────
# OS-specific (macOS / Linux)
# ────────────────────────────────
# macOS
.AppleDouble
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.apdisk

# Linux
.fuse_hidden*
.trash-*
nohup.out


# ────────────────────────────────
# Cache y builds intermedios
# ────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
*.tgz
*.tar.gz
*.zip
